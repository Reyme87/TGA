<Window x:Class="TGA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TGA"
        mc:Ignorable="d"
        Title="MainWindow" Height="600" Width="900" FontFamily="{StaticResource MainFont}" Background="{StaticResource ControlsColor}" Foreground="{StaticResource ForeColor}">

    <Window.Resources>
        <ResourceDictionary Source="ResourceDictionary.xaml"/>
    </Window.Resources>

    <Grid Background="{StaticResource BackColor}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.35*"/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <ListBox Grid.Row="0" Grid.Column="0" Grid.RowSpan="4" Padding="10 60 10 10" FontSize="20" ScrollViewer.VerticalScrollBarVisibility="Hidden">
            <ListBoxItem Margin="0,5,0,10">Элемент примера 1</ListBoxItem>
            <ListBoxItem Margin="0,5,0,10">Элемент примера 2</ListBoxItem>
            <ListBoxItem Margin="0,5,0,10">Элемент примера 3</ListBoxItem>
            <ListBoxItem Margin="0,5,0,10">Элемент примера 4</ListBoxItem>
            <ListBoxItem Margin="0,5,0,10">Элемент примера 5</ListBoxItem>
            <ListBoxItem Margin="0,5,0,10">Элемент примера 6</ListBoxItem>
            <ListBoxItem Margin="0,5,0,10">Элемент примера 7</ListBoxItem>
            <ListBoxItem Margin="0,5,0,10">Элемент примера 8</ListBoxItem>
            <ListBoxItem Margin="0,5,0,10">Элемент примера 9</ListBoxItem>
            <ListBoxItem Margin="0,5,0,10">Элемент примера 10</ListBoxItem>
            <ListBoxItem Margin="0,5,0,10">Элемент примера 10</ListBoxItem>
            <ListBoxItem Margin="0,5,0,10">Элемент примера 10</ListBoxItem>
            <ListBoxItem Margin="0,5,0,10">Элемент примера 10</ListBoxItem>
            <ListBoxItem Margin="0,5,0,10">Элемент примера 10</ListBoxItem>
            <ListBoxItem Margin="0,5,0,10">Элемент примера 10</ListBoxItem>
        </ListBox>
        <Label Content="Ваши каналы" Foreground="{StaticResource ForeColor}" FontSize="28" VerticalAlignment="Center" HorizontalAlignment="Center"/>

        <Border Grid.Column="1" Grid.ColumnSpan="2" Background="{StaticResource ControlsColor}" BorderBrush="Black" BorderThickness="0.75">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Grid.ColumnSpan="2">
                    <Label Content="Канал: Чемпионат" Foreground="{StaticResource ForeColor}" FontSize="18" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10 0 5 0"/>
                    <Label Content="Автор: @championat" Foreground="{StaticResource ForeColor}" FontSize="18" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10 -5 5 0"/>
                </StackPanel>
                <Button Style="{StaticResource BaseButtonStyle}" Content="Извлечь данные" Grid.Column="2" VerticalAlignment="Center" HorizontalContentAlignment="Center" Height="40" Margin="5"/>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="3">
            <ListBox d:ItemsSource="{d:SampleData ItemCount=3}" Background="{StaticResource BackColor}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ListBoxItem>
                            <Border CornerRadius="10" Margin="15 10" Background="{StaticResource ControlsColor}" HorizontalAlignment="Left" MaxWidth="450" MinWidth="100">
                                <StackPanel>
                                    <Label Content="Тематика поста: Спорт" Foreground="{StaticResource ForeColor}" FontSize="18" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10 5 5 0"/>
                                    <TextBlock Text="Сообщение поста: Какое-то сообщение длинное" Foreground="{StaticResource ForeColor}" FontSize="18" VerticalAlignment="Top" HorizontalAlignment="Left" TextWrapping="Wrap" Margin="10 5 5 0"/>
                                    <Label Content="Кол-во просмотров: 47.6К" Foreground="{StaticResource ForeColor}" FontSize="18" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10 5 5 0"/>
                                    <Label Content="Кол-во реакций: 1245" Foreground="{StaticResource ForeColor}" FontSize="18" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10 5 5 0"/>
                                </StackPanel>
                            </Border>
                        </ListBoxItem>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>
    </Grid>
</Window>
